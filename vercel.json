{
  "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @zilventor/app build",
  "installCommand": "echo 'install handled by buildCommand'",
  "outputDirectory": "packages/app/dist",
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/occt/:path*",
      "destination": "/occt/:path*"
    },
    {
      "source": "/icons/:path*",
      "destination": "/icons/:path*"
    },
    {
      "source": "/textures/:path*",
      "destination": "/textures/:path*"
    },
    {
      "source": "/(.*)\\.wasm",
      "destination": "/$1.wasm"
    },
    {
      "source": "/(.*)\\.js",
      "destination": "/$1.js"
    },
    {
      "source": "/(.*)\\.css",
      "destination": "/$1.css"
    },
    {
      "source": "/(.*)\\.webmanifest",
      "destination": "/$1.webmanifest"
    },
    {
      "source": "/(.*)\\.png",
      "destination": "/$1.png"
    },
    {
      "source": "/(.*)\\.svg",
      "destination": "/$1.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/occt/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
